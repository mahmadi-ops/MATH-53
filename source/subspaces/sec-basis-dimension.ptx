                    <line endpoints="((8.800,-1.500),(9.300,-1.000))" stroke="#D2D8C2" thickness="1"/>
                  </group>
                  <polygon points="((3.800,-1.500),(9.300,-1.500),(9.300,2.200),(3.800,2.200))" closed="yes" stroke="#9AA586" thickness="1"/>
                  <group at="second-basis-axes">
                    <line endpoints="((3.800,0.000),(9.300,0.000))" stroke="#606060" thickness="1" arrows="1"/>
                    <line endpoints="((6.300,-1.500),(6.300,2.200))" stroke="#606060" thickness="1" arrows="1"/>
                    <label p="(9.300,0.000)" alignment="nw" offset="(-3,3)"><m>x</m></label>
                    <label p="(6.300,2.200)" alignment="se" offset="(4,-4)"><m>y</m></label>
                  </group>
                  <label at="second-basis-plane" p="(9.300,2.200)" alignment="sw" offset="(-5,-5)"><m>H</m></label>
                  <group at="b2-e1">
                    <line endpoints="((6.300,0.000),(7.300,0.000))" stroke="#4A5D23" thickness="3" arrows="1"/>
                    <label p="(7.300,0.000)" alignment="s" offset="(0,-6)" color="#4A5D23"><m>\vec{e}_1</m></label>
                  </group>
                  <group at="b2-e12">
                    <line endpoints="((6.300,0.000),(7.300,1.000))" stroke="#876801" thickness="3" arrows="1"/>
                    <label p="(7.300,1.000)" alignment="e" offset="(6,2)" color="#876801"><m>\vec{e}_1+\vec{e}_2</m></label>
                  </group>
                  <label at="second-basis-name" p="(6.550,-1.500)" alignment="s" offset="(0,-6)"><m>\mathcal{B}_2 = \{\vec{e}_1,\ \vec{e}_1 + \vec{e}_2\}</m></label>
                </group>
              </group>
            </coordinates>
            <annotations>
              <annotation ref="two-bases" text="Two pictures of the same plane H, the xy-plane, seen from above with the x axis pointing right and the y axis pointing up; each shows a different basis and the grid of that basis, with the same scale on both axes">
                <annotation ref="first-basis" text="Left picture, the basis B 1">
                  <annotation ref="b1-e1" text="The olive vector e 1, one unit along the x axis"/>
                  <annotation ref="b1-e2" text="The mustard vector e 2, one unit along the y axis"/>
                  <annotation ref="first-basis-grid" text="The grid of this basis: horizontal and vertical lines one unit apart, forming squares"/>
                  <annotation ref="first-basis-name" text="The label B 1 equals the set e 1, e 2"/>
                </annotation>
                <annotation ref="second-basis" text="Right picture, the basis B 2">
                  <annotation ref="b2-e1" text="The olive vector e 1, one unit along the x axis, the same as on the left"/>
                  <annotation ref="b2-e12" text="The mustard vector e 1 plus e 2, from the origin to the point 1 comma 1, along the diagonal"/>
                  <annotation ref="second-basis-grid" text="The grid of this basis: horizontal lines one unit apart and diagonal lines of slope 1, forming slanted parallelograms that still cover the whole plane"/>
                  <annotation ref="second-basis-name" text="The label B 2 equals the set e 1, e 1 plus e 2"/>
                </annotation>
              </annotation>
            </annotations>
          </diagram>
        </prefigure>
      </image>
    </figure>

    <p>
      <em>Write a vector in each basis.</em> In
      <xref ref="fig-two-bases-interactive" text="type-global" /> you choose a vector
      <m>\begin{bmatrix} x \\ y \\ 0 \end{bmatrix}</m> of <m>H</m>, and the two pictures
      show it as a combination of the vectors of <m>\mathcal{B}_1</m> and of
      <m>\mathcal{B}_2</m>. The vector is the same in both pictures; only the weights
      change. Before moving it, predict the weights of
      <m>\begin{bmatrix} 2 \\ 1 \\ 0 \end{bmatrix}</m> in <m>\mathcal{B}_2</m>.
    </p>

    <figure xml:id="fig-two-bases-interactive">
      <caption>
        One vector of <m>H</m>, written in each basis of
        <xref ref="eg-two-bases" text="type-global" />. In the interactive figure the
        sliders, or the handle at the tip of the vector, set <m>x</m> and <m>y</m>; the
        olive and mustard arrows are the multiples of the two basis vectors that add up
        to the vector, and the readout gives the weights. The printed picture shows
        <m>\begin{bmatrix} 2 \\ 1 \\ 0 \end{bmatrix}
        = 2\vec{e}_1 + 1\vec{e}_2 = 1\vec{e}_1 + 1(\vec{e}_1 + \vec{e}_2)</m>.
      </caption>
      <interactive xml:id="int-two-bases" iframe="demos-manim/two-bases.html" width="100%" aspect="3:5">
        <shortdescription>Two pictures of the xy-plane seen from above show the same vector, set by sliders for its entries x and y, as a combination of e 1 and e 2 and as a combination of e 1 and e 1 plus e 2; a readout gives the weights in each basis.</shortdescription>
        <static>
          <image source="images/ch5-two-bases" width="92%">
            <shortdescription>The vector (2, 1, 0) drawn twice in the xy-plane: on the left as the sum of 2 e 1 and 1 e 2, on the right as the sum of 1 e 1 and 1 times e 1 plus e 2.</shortdescription>
          </image>
        </static>
      </interactive>
    </figure>
  </subsection>

  <subsection xml:id="subsec-all-bases-same-size">
    <title>All Bases Have the Same Size</title>

    <theorem xml:id="thm-spanning-vs-independent">
      <title>Spanning Sets Are at Least as Large as Independent Sets</title>
      <statement>
        <p>
          Suppose <m>\{ \vec{v}_1, \ldots, \vec{v}_r \}</m> is a linearly independent set
          of vectors in <m>\R^n</m>, and each <m>\vec{v}_k</m> is contained in
          <m>\operatorname{Span}\{ \vec{w}_1, \ldots, \vec{w}_s \}</m>. Then
          <m>s \geq r</m>.
        </p>
        <p>
          In words, spanning sets have at least as many vectors as linearly independent
          sets.
        </p>
      </statement>
      <proof>
        <p>
          Since each <m>\vec{v}_j</m> is in
          <m>\operatorname{Span}\{ \vec{w}_1, \ldots, \vec{w}_s \}</m>, there exist
          scalars <m>a_{ij}</m> such that
          <md>
            \vec{v}_j = \sum_{i=1}^{s} a_{ij} \vec{w}_i.
          </md>
        </p>
        <p>
          Suppose for a contradiction that <m>s \lt r</m>. Then the matrix
          <m>A = \begin{bmatrix} a_{ij} \end{bmatrix}</m> has fewer rows, <m>s</m>, than
          columns, <m>r</m>. Then the system <m>AX = 0</m> has a nontrivial solution
          <m>\vec{d}</m>; that is, there is a <m>\vec{d} \neq \vec{0}</m> such that
          <m>A\vec{d} = \vec{0}</m>. In other words,
          <md>
            \sum_{j=1}^{r} a_{ij} d_j = 0, \qquad i = 1, 2, \ldots, s.
          </md>
        </p>
        <p>
          Therefore
          <md>
            <mrow>
              \sum_{j=1}^{r} d_j \vec{v}_j
              \amp = \sum_{j=1}^{r} d_j \sum_{i=1}^{s} a_{ij} \vec{w}_i
            </mrow>
            <mrow>
              \amp = \sum_{i=1}^{s} \left( \sum_{j=1}^{r} a_{ij} d_j \right) \vec{w}_i
              = \sum_{i=1}^{s} 0 \vec{w}_i = \vec{0},
            </mrow>
          </md>
          which contradicts the assumption that
          <m>\{ \vec{v}_1, \ldots, \vec{v}_r \}</m> is linearly independent, because not
          all the <m>d_j</m> are zero. Thus this contradiction indicates that
          <m>s \geq r</m>.
        </p>
      </proof>
    </theorem>

    <theorem xml:id="thm-bases-same-size">
      <title>Any Two Bases Have the Same Size</title>
      <statement>
        <p>
          Let <m>H</m> be a subspace of <m>\R^n</m> and suppose
          <m>\{ \vec{v}_1, \ldots, \vec{v}_r \}</m> and
          <m>\{ \vec{w}_1, \ldots, \vec{w}_s \}</m> are two bases for <m>H</m>. Then
          <m>r = s</m>.
        </p>
      </statement>
      <proof>
        <p>
          Note that any spanning set has at least as many vectors as a basis, by
          <xref ref="thm-spanning-vs-independent" text="type-global" />. Also, any basis
          is itself a spanning set. Hence:
        </p>
        <p>
          <ol>
            <li>
              <p>
                <m>\{ \vec{v}_1, \ldots, \vec{v}_r \}</m> is a basis and
                <m>\{ \vec{w}_1, \ldots, \vec{w}_s \}</m> is a spanning set, therefore
                <m>r \leq s</m>.
              </p>
            </li>
            <li>
              <p>
                <m>\{ \vec{w}_1, \ldots, \vec{w}_s \}</m> is a basis and
                <m>\{ \vec{v}_1, \ldots, \vec{v}_r \}</m> is a spanning set, therefore
                <m>s \leq r</m>.
              </p>
            </li>
          </ol>
        </p>
        <p>
          Together these give <m>r = s</m>.
        </p>
      </proof>
    </theorem>
  </subsection>

  <subsection xml:id="subsec-dimension">
    <title>Dimension</title>

    <definition xml:id="def-dimension">
      <title>Dimension</title>
      <statement>
        <p>
          Let <m>H</m> be a subspace of <m>\R^n</m>. Then the <term>dimension</term> of
          <m>H</m> is the number of vectors in a basis of <m>H</m>.
        </p>
      </statement>
    </definition>

    <remark xml:id="rem-dimension-well-defined">
      <p>
        This definition makes sense only because of
        <xref ref="thm-bases-same-size" text="type-global" />: different bases could
        otherwise give different answers.
      </p>
    </remark>

    <example xml:id="eg-dimension">
      <title>Computing Dimensions</title>
      <statement>
        <p>
          What is the dimension of the following subspaces of <m>\R^3</m>?
        </p>
        <p>
          <md>
            H_1 = \left\{ \begin{bmatrix} x \\ y \\ z \end{bmatrix} \in \R^3 \; \middle| \; x = y = z \right\},
            \qquad
            H_2 = \left\{ \vec{u} \in \R^3 \; \middle| \; \vec{u} \cdot \vec{v} = 0, \;
              \vec{v} = \begin{bmatrix} 2 \\ -1 \\ 1 \end{bmatrix} \right\}.
          </md>
        </p>
      </statement>
      <solution>
        <p>
          <m>H_1</m> is a line through the origin with the direction vector
          <m>\vec{v} = \begin{bmatrix} 1 \\ 1 \\ 1 \end{bmatrix}</m> and
          <m>H_1 = \operatorname{Span}\{ \vec{v} \}</m>, hence
          <md>
            \dim H_1 = 1.
          </md>
        </p>
        <p>
          For <m>H_2</m>, write <m>\vec{u} = \begin{bmatrix} x \\ y \\ z \end{bmatrix}</m>.
          Then <m>\vec{u} \cdot \vec{v} = 2x - y + z = 0</m>, which is a plane through the
          origin, and
          <md>
            H_2 = \operatorname{Span}\left\{
              \begin{bmatrix} 0 \\ 1 \\ 1 \end{bmatrix},
              \begin{bmatrix} 1 \\ 1 \\ -1 \end{bmatrix} \right\}.
          </md>
          Note that any two vectors on the plane that are linearly independent can be used
          here. Hence
          <md>
            \dim H_2 = 2.
          </md>
        </p>
      </solution>
    </example>
  </subsection>
</section>
