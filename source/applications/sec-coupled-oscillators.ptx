                  <annotation ref="sm-a-left-spring" text="The left spring is stretched"/>
                  <annotation ref="sm-a-middle-spring" text="The middle spring has its rest length"/>
                  <annotation ref="sm-a-right-spring" text="The right spring is compressed"/>
                  <annotation ref="sm-a-length" text="A double arrow above the middle spring marks its length l, unchanged"/>
