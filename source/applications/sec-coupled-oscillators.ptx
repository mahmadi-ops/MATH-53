                  <annotation ref="sf-b-middle-spring" text="The middle spring is stretched by u 2 minus u 1"/>
                  <annotation ref="sf-b-right-spring" text="The right spring is compressed by u 2"/>
                  <annotation ref="sf-b-forces1" text="Two force arrows above cart 1: a short olive arrow to the left labelled k u 1, from the left spring, and a longer wine arrow to the right labelled k times u 2 minus u 1, from the middle spring"/>
